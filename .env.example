# copy to .env and fill in — NEVER commit .env
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=backend/service-account.json
ESCALATION_MINUTES=2
# Extra exact CORS origins, comma-separated (e.g. https://tars-demo.example.com,http://192.168.1.20:5173).
# Not needed for local dev: any http://localhost:<port> and http://127.0.0.1:<port> is already allowed. "*" is ignored.
CORS_ORIGINS=
# 1 = demo mode: enables POST /api/admin/reset-demo (HOD only) to restore the seeded timetable between runs.
# Empty/anything else = off (the endpoint returns 404). Leave off outside demos.
TARS_DEMO_MODE=
# Password for EVERY seeded user (students, faculty, HOD); applied by `python3 app/seed.py` and by the demo reset.
# Pick your own; never commit it. Empty = users have no password (then only passwordless login, if enabled, works).
TARS_DEMO_PASSWORD=
# Signs login tokens. Use a long random value, e.g.  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty = a random secret per backend start (works, but everyone is logged out on every restart).
TARS_SESSION_SECRET=
# 1 = allow login without a password (local testing only). Empty/anything else = passwords required.
TARS_PASSWORDLESS_LOGIN=
